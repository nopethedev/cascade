# --- General ---
PORT=3000
# main | node
SERVER_MODE=main
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# SQLite database (Sequelize). A legacy ./data/db.json is imported once if present.
DB_PATH=./data/cascade.sqlite
STORAGE_DIR=./data/uploads

# --- Theme (customizable, can also be changed in Admin → Appearance) ---
SITE_NAME=Cascade
THEME_ACCENT=#e11d48
THEME_BG=#08080a
THEME_SURFACE=#101013
THEME_TEXT=#f3f3f4

# --- Node mode only ---
# Public URL of this node is not needed. Main server connects TO the node.
# Access key the main server must send as `x-node-key`. Auto-generated on
# first boot if empty; read it from data/node-key.txt (mode 0600).
NODE_ACCESS_KEY=
# Bind host for node mode
HOST=0.0.0.0

# --- Main server node-client defaults ---
# How often (ms) to health-check nodes + auto re-replicate
HEALTHCHECK_INTERVAL_MS=30000
