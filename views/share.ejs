<%- include('partials/head', { title: file.filename, shellClass: 'shell shell-narrow' }) %>
<%
  const mime = file.mime || 'application/octet-stream';
  const isImage = mime.startsWith('image/');
  const isVideo = mime.startsWith('video/');
  const isAudio = mime.startsWith('audio/');
  const ext = file.filename.includes('.') ? file.filename.split('.').pop().slice(0, 5) : 'file';
  const size = prettyBytes(file.size);
%>

<div style="text-align:center;margin-bottom:24px">
  <div class="eyebrow">Shared file</div>
  <h1 class="page-title" style="word-break:break-word"><%= file.filename %></h1>
  <p class="lede" style="margin-left:auto;margin-right:auto"><%= mime %> · <%= size %> · shared via <%= theme.siteName %></p>
</div>

<section class="panel">
  <div class="panel-body">
    <div class="preview">
      <% if (isImage) { %>
        <img src="/raw/<%= file.slug %>" alt="<%= file.filename %>" />
      <% } else if (isVideo) { %>
        <video src="/raw/<%= file.slug %>" controls></video>
      <% } else if (isAudio) { %>
        <audio src="/raw/<%= file.slug %>" controls></audio>
      <% } else { %>
        <div class="preview-none">
          <span class="file-ico"><%= ext %></span>
          <strong>No inline preview</strong>
          <span>Download the file to open it locally.</span>
        </div>
      <% } %>
    </div>

    <div class="row" style="justify-content:center;margin-top:18px">
      <a class="btn" href="/raw/<%= file.slug %>">Download</a>
      <button class="btn btn-ghost" type="button" onclick="cascadeCopy(location.origin + '/raw/<%= file.slug %>')">Copy CDN link</button>
    </div>

    <div class="field" style="margin-top:20px">
      <span class="label">CDN URL · immutable cache</span>
      <div class="copyrow">
        <input value="/raw/<%= file.slug %>" readonly aria-label="CDN path" />
        <button class="btn btn-ghost btn-sm" type="button" onclick="cascadeCopy(location.origin + '/raw/<%= file.slug %>')">Copy</button>
      </div>
    </div>
  </div>
</section>

<p class="hint" style="text-align:center;margin-top:16px">Embed this URL anywhere — it is served with long-lived cache headers.</p>
<%- include('partials/foot') %>
