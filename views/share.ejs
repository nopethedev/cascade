<%- include('partials/head', { title: file.filename, shellClass: 'shell shell-narrow' }) %>
<%
  const mime = file.mime || 'application/octet-stream';
  const isImage = mime.startsWith('image/');
  const isVideo = mime.startsWith('video/');
  const isAudio = mime.startsWith('audio/');
  const ext = file.filename.includes('.') ? file.filename.split('.').pop().slice(0, 5) : 'file';
  const size = prettyBytes(file.size);
%>

<div class="mx-auto mb-8 max-w-3xl text-center">
  <div class="eyebrow mx-auto">Shared file</div>
  <h1 class="page-title [overflow-wrap:anywhere]"><%= file.filename %></h1>
  <p class="lede mx-auto"><%= mime %> · <%= size %> · shared via <%= theme.siteName %></p>
</div>

<section class="panel mx-auto max-w-4xl overflow-hidden">
  <div class="p-3 sm:p-5">
    <div class="preview">
      <% if (isImage) { %>
        <img src="/raw/<%= file.slug %>" alt="<%= file.filename %>" />
      <% } else if (isVideo) { %>
        <video src="/raw/<%= file.slug %>" controls></video>
      <% } else if (isAudio) { %>
        <audio src="/raw/<%= file.slug %>" controls></audio>
      <% } else { %>
        <div class="preview-none">
          <span class="file-ico"><%= ext %></span>
          <strong>No inline preview</strong>
          <span>Download the file to open it locally.</span>
        </div>
      <% } %>
    </div>

    <div class="mt-5 flex flex-wrap justify-center gap-2">
      <a class="btn" href="/raw/<%= file.slug %>"><i data-lucide="download"></i>Download</a>
      <button class="btn btn-ghost" type="button" onclick="cascadeCopy(location.origin + '/raw/<%= file.slug %>')"><i data-lucide="copy"></i>Copy CDN link</button>
    </div>

    <div class="mx-auto mt-6 max-w-2xl">
      <div class="field">
        <span class="label">CDN URL · immutable cache</span>
        <div class="copyrow">
          <input value="/raw/<%= file.slug %>" readonly aria-label="CDN path" />
          <button class="btn btn-ghost btn-sm" type="button" onclick="cascadeCopy(location.origin + '/raw/<%= file.slug %>')"><i data-lucide="copy"></i>Copy</button>
        </div>
      </div>
    </div>
  </div>
</section>

<p class="hint mt-4 text-center">Embed this URL anywhere — it is served with long-lived cache headers.</p>
<%- include('partials/foot') %>
