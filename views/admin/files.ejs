<%- include('../partials/head', { title: 'Admin · Files' }) %>
<%- include('../partials/admin-tabs', { tab: 'files' }) %>
<%
  const extOf = (name) => (name.includes('.') ? name.split('.').pop().slice(0, 4) : 'file');
%>

<div class="page-head">
  <div>
    <div class="eyebrow">Admin</div>
    <h1 class="page-title">All files</h1>
    <p class="lede">Every file on the server. Admins can open, share and delete anything.</p>
  </div>
  <div class="actions"><span class="badge"><%= files.length %> file<%= files.length === 1 ? '' : 's' %></span></div>
</div>

<section class="panel has-table">
  <div class="panel-head"><div class="panel-title">Files</div></div>
  <% if (!files.length) { %>
    <div class="panel-body">
      <div class="empty">
        <div class="empty-ico">∅</div>
        <strong>Nothing uploaded yet</strong>
        <span>Files from every user will be listed here.</span>
      </div>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>File</th><th>Owner</th><th>Size</th><th>Replicas</th><th>Share</th><th class="right"></th></tr>
        </thead>
        <tbody>
          <% for (const f of files) { %>
            <tr>
              <td>
                <a class="file" href="/f/<%= f.id %>">
                  <span class="file-ico"><%= extOf(f.filename) %></span>
                  <span style="min-width:0">
                    <span class="file-name"><%= f.filename %></span>
                    <span class="file-meta"><%= f.id %></span>
                  </span>
                </a>
              </td>
              <td><%= f.ownerName || f.ownerId %></td>
              <td class="muted nowrap"><%= prettyBytes(f.size) %></td>
              <td><span class="badge"><%= (f.replicas || []).length %>×</span></td>
              <td>
                <% if (f.isPublic) { %>
                  <a href="/c/<%= f.slug %>"><span class="badge badge-accent">public</span></a>
                <% } else { %>
                  <span class="badge">private</span>
                <% } %>
              </td>
              <td>
                <div class="row" style="justify-content:flex-end;gap:4px">
                  <a class="btn btn-quiet btn-sm" href="/f/<%= f.id %>">Open</a>
                  <button class="btn btn-quiet btn-sm" type="button" onclick="cascadeDelete('<%= f.id %>','<%= f.filename.replace(/'/g, '') %>')">Delete</button>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('../partials/foot') %>
