<%- include('../partials/head', { title: 'Admin · Overview' }) %>
<%- include('../partials/admin-tabs', { tab: 'overview' }) %>
<%
%>

<div class="page-head">
  <div>
    <div class="eyebrow">Admin</div>
    <h1 class="page-title">Server overview</h1>
    <p class="lede">One view of the main server and every storage node attached to it.</p>
  </div>
  <div class="actions">
    <a class="btn btn-ghost" href="/admin/nodes">Add or manage nodes</a>
    <a class="btn btn-quiet" href="/admin/files">All files</a>
  </div>
</div>

<div class="stat-grid">
  <div class="stat"><b><%= stats.users %></b><span>Users</span></div>
  <div class="stat"><b><%= stats.files %></b><span>Files</span></div>
  <div class="stat"><b><%= prettyBytes(stats.bytes) %></b><span>Total stored</span></div>
  <div class="stat stat-accent"><b><%= stats.nodes %></b><span>Nodes incl. local</span></div>
</div>

<div class="split" style="margin-top:16px">
  <section class="panel has-table">
    <div class="panel-head">
      <div>
        <div class="panel-title">Nodes</div>
        <div class="panel-sub">Local disk plus every remote storage node</div>
      </div>
      <span class="badge"><%= stats.nodes %> total</span>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Node</th><th>Status</th><th class="right">Usage</th></tr></thead>
        <tbody>
          <tr>
            <td>
              <div class="row" style="gap:9px">
                <span class="dot dot-ok"></span>
                <div>
                  <strong>This server</strong>
                  <div class="file-meta">local</div>
                </div>
              </div>
            </td>
            <td><span class="badge badge-ok">always on</span></td>
            <td class="right muted nowrap"><%= prettyBytes(local.bytes) %> · <%= local.count %> objects</td>
          </tr>
          <% for (const r of remoteStats) { const online = r.status.online; %>
            <tr>
              <td>
                <div class="row" style="gap:9px">
                  <span class="dot <%= online ? 'dot-ok' : 'dot-bad' %>"></span>
                  <div style="min-width:0">
                    <strong><%= r.node.name %></strong>
                    <div class="file-meta"><%= r.node.url %></div>
                  </div>
                </div>
              </td>
              <td>
                <% if (!online) { %>
                  <span class="badge badge-bad">offline</span>
                <% } else { %>
                  <span class="badge badge-ok">online<%= r.status.latencyMs != null ? ' · ' + r.status.latencyMs + 'ms' : '' %></span>
                <% } %>
              </td>
              <td class="right muted nowrap"><%= r.usage ? prettyBytes(r.usage.bytes) + ' · ' + r.usage.count + ' objects' : '—' %></td>
            </tr>
          <% } %>
          <% if (!remoteStats.length) { %>
            <tr><td colspan="3" class="muted">No remote nodes yet — this server is storing everything locally.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head"><div class="panel-title">Replication</div></div>
    <div class="panel-body stack">
      <dl class="kv">
        <dt>Mode</dt><dd><span class="badge badge-accent"><%= replication.mode %></span></dd>
        <dt>Copies</dt><dd><%= stats.desired %></dd>
        <dt>Selected</dt><dd><%= (replication.selectedNodeIds || []).join(', ') || '—' %></dd>
        <dt>Default</dt><dd><%= replication.defaultNodeId || 'local' %></dd>
      </dl>
      <p class="hint">Health checks run every 30 seconds. In “all” and “N copies” modes, files are re-replicated when a node goes down.</p>
      <div><a class="btn btn-ghost btn-sm" href="/admin/nodes">Change replication</a></div>
    </div>
  </section>
</div>
<%- include('../partials/foot') %>
