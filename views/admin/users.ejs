<%- include('../partials/head', { title: 'Admin · Users' }) %>
<%- include('../partials/admin-tabs', { tab: 'users' }) %>

<div class="page-head">
  <div>
    <div class="eyebrow">Admin</div>
    <h1 class="page-title">Users</h1>
    <p class="lede">Create accounts, set roles and give every person their own storage quota.</p>
  </div>
  <div class="actions"><span class="badge"><%= users.length %> accounts</span></div>
</div>

<section class="panel">
  <div class="panel-head">
    <div>
      <div class="panel-title">Create user</div>
      <div class="panel-sub">Passwords need at least 6 characters.</div>
    </div>
  </div>
  <div class="panel-body">
    <form method="post" action="/admin/users" class="form-grid">
      <div class="field">
        <label class="label" for="nu">Username</label>
        <input id="nu" name="username" autocomplete="off" required />
      </div>
      <div class="field">
        <label class="label" for="np">Password</label>
        <input id="np" name="password" type="password" minlength="6" autocomplete="new-password" required />
      </div>
      <div class="field">
        <label class="label" for="nr">Role</label>
        <select id="nr" name="role">
          <option value="user">user</option>
          <option value="admin">admin</option>
        </select>
      </div>
      <div class="field">
        <label class="label" for="nq">Quota (MB)</label>
        <input id="nq" name="quotaMB" type="number" min="1" step="1" value="5120" inputmode="numeric" />
        <div class="hint">100 MB = 0.1 GB. Fractions are allowed, e.g. 102.4 MB.</div>
      </div>
      <div class="span-2"><button class="btn" type="submit">Create user</button></div>
    </form>
  </div>
</section>

<section class="panel has-table" style="margin-top:16px">
  <div class="panel-head"><div class="panel-title">Accounts</div></div>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th>User</th><th>Role</th><th style="width:26%">Storage</th><th>Files</th><th class="right">Manage</th></tr>
      </thead>
      <tbody>
        <% for (const u of users) { const pct = u.quotaBytes ? Math.min(100, Math.round((u.used / u.quotaBytes) * 100)) : 0; %>
          <tr>
            <td>
              <strong><%= u.username %></strong>
              <div class="file-meta"><%= u.id.slice(0, 8) %></div>
            </td>
            <td><span class="badge <%= u.role === 'admin' ? 'badge-accent' : '' %>"><%= u.role %></span></td>
            <td>
              <div class="meter-row" style="font-size:12px;margin-bottom:6px">
                <span><%= (u.used / 1048576).toFixed(1) %> MB</span>
                <span><%= prettyBytes(u.quotaBytes) %></span>
              </div>
              <div class="meter"><div class="meter-fill" style="width:<%= pct %>%"></div></div>
            </td>
            <td class="muted"><%= u.fileCount %></td>
            <td>
              <div class="row" style="justify-content:flex-end;gap:6px">
                <form method="post" action="/admin/users/<%= u.id %>/quota" class="row" style="gap:6px">
                  <input name="quotaMB" type="number" min="1" step="0.1" value="<%= Number((u.quotaBytes / 1048576).toFixed(1)) %>" style="width:86px;height:30px" title="Quota in MB" aria-label="Quota in MB for <%= u.username %>" inputmode="decimal" />
                  <select name="role" style="width:86px;height:30px" aria-label="Role for <%= u.username %>">
                    <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>user</option>
                    <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
                  </select>
                  <button class="btn btn-ghost btn-sm" type="submit">Save</button>
                </form>
                <form method="post" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('Delete <%= u.username %>? Their files stay on disk.')">
                  <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/foot') %>
