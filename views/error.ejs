<%- include('partials/head', { title: 'Error', shellClass: 'shell shell-narrow' }) %>
<div class="flex min-h-[62vh] flex-col items-center justify-center py-16 text-center">
  <div class="mb-6 grid h-16 w-16 place-items-center rounded-[22px] border border-rose-400/20 bg-rose-400/[0.08] text-rose-300 shadow-[0_0_50px_-18px_rgba(244,63,94,.6)]">
    <i data-lucide="triangle-alert" class="h-7 w-7"></i>
  </div>
  <div class="eyebrow">Error</div>
  <h1 class="text-[clamp(58px,12vw,104px)] font-semibold leading-none tracking-[-0.07em] text-[var(--accent)] [font-variant-numeric:tabular-nums]"><%= status || 500 %></h1>
  <p class="mt-5 max-w-[52ch] text-[14px] leading-relaxed text-[var(--muted)]"><%= message %></p>
  <div class="mt-8 flex flex-wrap justify-center gap-2">
    <a class="btn" href="/"><i data-lucide="folder"></i>Back to files</a>
    <a class="btn btn-ghost" href="/docs"><i data-lucide="book-open"></i>Documentation</a>
  </div>
</div>
<%- include('partials/foot') %>
