<%- include('../partials/head', { title: file.filename, shellClass: 'shell shell-wide' }) %>
<%- include('../partials/editor-bar', { file, kind }) %>

<div class="ed-toolbar">
  <div class="tool-group" id="board-tools">
    <button class="tool is-active" type="button" data-tool="select" title="Select / move (V)">Select</button>
    <button class="tool" type="button" data-tool="pen" title="Pen (P)">Pen</button>
    <button class="tool" type="button" data-tool="rect" title="Rectangle (R)">Rect</button>
    <button class="tool" type="button" data-tool="ellipse" title="Ellipse (O)">Ellipse</button>
    <button class="tool" type="button" data-tool="arrow" title="Arrow / connector (A)">Arrow</button>
    <button class="tool" type="button" data-tool="sticky" title="Sticky note (S)">Sticky</button>
    <button class="tool" type="button" data-tool="text" title="Text (T)">Text</button>
    <button class="tool" type="button" data-tool="eraser" title="Eraser (E)">Eraser</button>
    <button class="tool" type="button" data-tool="pan" title="Pan (H / hold Space)">Hand</button>
  </div>
  <div class="tool-group">
    <label class="tool tool-color" title="Colour">Colour<input type="color" id="board-color" value="#e11d48" /></label>
    <select class="tool-select" id="board-width" aria-label="Stroke width">
      <option value="2">Thin</option>
      <option value="4" selected>Medium</option>
      <option value="8">Thick</option>
    </select>
  </div>
  <div class="tool-group">
    <button class="tool" type="button" id="board-undo" title="Undo">↶</button>
    <button class="tool" type="button" id="board-redo" title="Redo">↷</button>
    <button class="tool" type="button" id="board-zoom-out" title="Zoom out">−</button>
    <button class="tool" type="button" id="board-zoom-in" title="Zoom in">+</button>
    <button class="tool" type="button" id="board-reset">Fit</button>
  </div>
  <span class="tool-spacer"></span>
  <span class="hint" id="board-hint">Wheel to zoom · space or middle-drag to pan</span>
</div>

<div class="board-wrap" id="board-wrap">
  <canvas id="board"></canvas>
  <div class="board-overlay" id="board-overlay"></div>
</div>

<script>
  window.__DOC__ = <%- JSON.stringify({ id: file.id, version: file.version, isPublic: !!file.isPublic, filename: file.filename, content }).replace(/</g, '\\u003c') %>;
</script>
<script src="/public/editors/common.js"></script>
<script src="/public/editors/board.js"></script>
<%- include('../partials/foot') %>
