<%- include('../partials/head', { title: file.filename, appMode: true, app: kind.id, shellClass: 'shell shell-wide deck-shell' }) %>
<%- include('../partials/editor-bar', { file, kind, accessRole, canEdit }) %>

<div class="ed-toolbar deck-toolbar" id="deck-toolbar" role="toolbar" aria-label="Slide tools">
  <div class="tool-group">
    <button class="tool" type="button" id="add-text" title="Add text (T)">+ Text</button>
    <button class="tool" type="button" id="add-rect" title="Add shape (R)">+ Shape</button>
    <button class="tool" type="button" id="add-image" title="Add image">+ Image</button>
  </div>
  <div class="tool-group">
    <select class="tool-select" id="deck-layout-select" aria-label="Apply slide layout" title="Slide layout">
      <option value="">Layout…</option>
      <option value="title">Title slide</option>
      <option value="title-body">Title + content</option>
      <option value="two-col">Two columns</option>
      <option value="quote">Big quote</option>
      <option value="section">Section break</option>
      <option value="blank">Blank</option>
    </select>
  </div>
  <div class="tool-group deck-align-tools" aria-label="Align selected element">
    <button class="tool" type="button" data-align="left" title="Align left">⇤</button>
    <button class="tool" type="button" data-align="center" title="Align centre">↔</button>
    <button class="tool" type="button" data-align="right" title="Align right">⇥</button>
    <button class="tool" type="button" data-align="top" title="Align top">⇡</button>
    <button class="tool" type="button" data-align="middle" title="Align middle">↕</button>
    <button class="tool" type="button" data-align="bottom" title="Align bottom">⇣</button>
  </div>
  <div class="tool-group">
    <button class="tool" type="button" id="deck-undo" title="Undo (Ctrl+Z)">↶</button>
    <button class="tool" type="button" id="deck-redo" title="Redo (Ctrl+Shift+Z)">↷</button>
    <button class="tool" type="button" id="deck-duplicate" title="Duplicate element (Ctrl+D)">Duplicate</button>
    <button class="tool" type="button" id="deck-delete" title="Delete element">Delete</button>
  </div>
  <span class="tool-spacer"></span>
  <span class="hint deck-save-hint" id="deck-slide-label">Slide 1</span>
  <button class="btn btn-ghost btn-sm" type="button" id="deck-preview" title="Preview animations on this slide">Play</button>
  <button class="btn btn-ghost btn-sm" type="button" id="deck-inspector-toggle" aria-expanded="false">Design</button>
  <button class="btn btn-sm" type="button" id="deck-present">Present</button>
</div>

<div class="deck-layout" id="deck-layout">
  <aside class="deck-slides" aria-label="Slides">
    <div class="deck-slides-head">
      <span>Slides</span>
      <span class="hint" id="deck-slide-count"></span>
    </div>
    <div id="slide-list" class="slide-list"></div>
    <button class="btn btn-ghost btn-sm btn-block" type="button" id="add-slide">+ New slide</button>
  </aside>

  <div class="deck-center">
    <div class="deck-canvas-bar">
      <div class="row" style="gap:4px">
        <button class="tool" type="button" id="deck-prev-slide" title="Previous slide">‹</button>
        <span class="hint" id="deck-slide-label-mobile">1 / 1</span>
        <button class="tool" type="button" id="deck-next-slide" title="Next slide">›</button>
      </div>
      <div class="row" style="gap:4px">
        <button class="tool" type="button" id="deck-zoom-out" title="Zoom out">−</button>
        <span class="hint" id="deck-zoom-label">100%</span>
        <button class="tool" type="button" id="deck-zoom-in" title="Zoom in">+</button>
        <button class="tool" type="button" id="deck-zoom-fit" title="Fit to window">Fit</button>
      </div>
    </div>
    <div class="deck-stage-wrap" id="stage-wrap">
      <div class="deck-stage" id="stage"></div>
      <div class="deck-guides" id="stage-guides" aria-hidden="true"></div>
    </div>
    <div class="deck-mobile-slides" id="deck-mobile-slides"></div>
  </div>

  <aside class="deck-props panel" id="deck-props" aria-label="Design and animation inspector">
    <div class="panel-head">
      <div class="panel-title">Design</div>
      <button class="btn btn-quiet btn-sm" type="button" id="deck-inspector-close" aria-label="Close inspector">×</button>
    </div>
    <div class="panel-body stack" id="props-body"></div>
  </aside>
</div>

<script>
  window.__DOC__ = <%- JSON.stringify({ id: file.id, version: file.version, isPublic: !!file.isPublic, filename: file.filename, content, canEdit }).replace(/</g, '\\u003c') %>;
  window.__ACCESS__ = <%- JSON.stringify({ role: accessRole || 'owner', canEdit: !!canEdit, shareMode: typeof shareMode !== 'undefined' && !!shareMode }).replace(/</g, '\\u003c') %>;
</script>
<script src="/public/editors/common.js"></script>
<script src="/public/image-library.js"></script>
<script src="/public/editors/deck.js"></script>
<%- include('../partials/foot', { appMode: true }) %>
