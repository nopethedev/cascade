    <div class="eyebrow">Documentation</div>
    <h1 class="page-title">Cascade API &amp; self-hosting</h1>
    <p class="lede">Everything needed to script <%= theme.siteName %> or run it next to your own stack. Running in <span class="code"><%= mode %></span> mode.</p>
  </div>
  <div class="actions"><a class="btn btn-ghost" href="/docs#api">Jump to API</a></div>
</div>

