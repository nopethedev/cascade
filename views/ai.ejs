<%- include('partials/head', { title: 'Cascade AI', appMode: true, app: 'ai', shellClass: 'shell shell-ai' }) %>
<link rel="stylesheet" href="/public/vendor/ai/katex/katex.min.css" />
<link rel="stylesheet" href="/public/vendor/ai/highlight/github-dark.min.css" />
<link rel="stylesheet" href="/public/ai/ai.css" />

<div class="ai-app" id="ai-app">
  <aside class="ai-sidebar" id="ai-sidebar" aria-label="Conversations">
    <div class="ai-brand">
      <span class="ai-brand-mark">C</span>
      <span class="ai-brand-text"><b>CASCADE</b><i>AI</i></span>
      <button type="button" class="ai-iconbtn ai-sidebar-close" data-ai="toggle-side" aria-label="Close sidebar">✕</button>
    </div>
    <button type="button" class="ai-new" data-ai="new"><span>＋</span> New chat</button>
    <label class="ai-search-wrap">
      <span aria-hidden="true">⌕</span>
      <input id="ai-search" type="search" placeholder="Search conversations…" autocomplete="off">
    </label>
    <div class="ai-side-scroll">
      <div class="ai-side-group">
        <div class="ai-side-head"><span>Conversations</span><button type="button" class="ai-mini" data-ai="new-folder" title="New folder">＋</button></div>
        <div id="ai-folders" class="ai-folders"></div>
        <div id="ai-convos" class="ai-convos"><p class="ai-empty-small">No conversations yet.</p></div>
      </div>
    </div>
    <div class="ai-side-foot">
      <button type="button" data-ai="open-knowledge"><span>▤</span> Knowledge</button>
      <button type="button" data-ai="open-assistants"><span>✦</span> Assistants</button>
      <button type="button" data-ai="open-usage"><span>▦</span> Usage</button>
      <a href="/"><span>◧</span> Cascade Files</a>
      <% if (user && user.role === 'admin') { %><a href="/admin/ai"><span>⚙</span> AI settings</a><% } %>
    </div>
  </aside>

  <main class="ai-main">
    <header class="ai-topbar">
      <button type="button" class="ai-iconbtn ai-menu-btn" data-ai="toggle-side" aria-label="Open sidebar">☰</button>
      <div class="ai-title" id="ai-title">New chat</div>
      <div class="ai-controls">
        <select id="ai-assistant" class="ai-select" title="Assistant" aria-label="Assistant">
          <option value="">Default assistant</option>
        </select>
        <select id="ai-provider" class="ai-select" title="Provider" aria-label="Provider"></select>
        <select id="ai-model" class="ai-select ai-model" title="Model" aria-label="Model"></select>
        <button type="button" class="ai-toggle is-on" data-ai="toggle-tools" id="ai-tools-toggle" title="Allow MCP tool calls">Tools</button>
        <button type="button" class="ai-toggle" data-ai="toggle-web" id="ai-web-toggle" title="Search the web before answering">Web</button>
        <button type="button" class="ai-toggle" data-ai="open-knowledge" id="ai-kb-toggle" title="Attach knowledge bases">Knowledge<b id="ai-kb-count" hidden></b></button>
        <button type="button" class="ai-iconbtn" data-ai="open-image" title="Generate an image">◈</button>
      </div>
    </header>

    <section class="ai-chat" id="ai-chat" aria-live="polite">
      <div class="ai-loading" id="ai-loading" hidden><span class="ai-spinner"></span> Loading conversation…</div>
    </section>

    <div class="ai-composer-wrap">
      <div class="ai-attachments" id="ai-attachments" hidden></div>
      <form class="ai-composer" id="ai-form" autocomplete="off">
        <textarea id="ai-input" rows="1" placeholder="Message Cascade AI…  (Enter to send, Shift+Enter for a new line)" aria-label="Message"></textarea>
        <div class="ai-composer-actions">
          <button type="button" class="ai-iconbtn" data-ai="attach" title="Attach files or images">📎</button>
          <button type="button" class="ai-iconbtn" data-ai="mic" id="ai-mic" title="Voice input">🎙</button>
          <button type="submit" class="ai-send" id="ai-send" title="Send (Enter)">Send<kbd>↵</kbd></button>
          <button type="button" class="ai-stop" id="ai-stop" hidden>Stop</button>
        </div>
      </form>
      <div class="ai-hint" id="ai-hint">Cascade AI can create documents, decks, sheets, sites and video projects through MCP tools.</div>
      <input id="ai-file-input" type="file" multiple hidden>
    </div>
  </main>
</div>

<!-- Code preview -->
<dialog class="ai-dialog ai-dialog-wide" id="ai-preview-dlg">
  <div class="ai-dialog-inner">
    <div class="ai-dialog-head"><h2 id="ai-preview-title">Code preview</h2><button type="button" class="ai-iconbtn" data-close-dialog aria-label="Close">✕</button></div>
    <div class="ai-dialog-body ai-preview-body"><iframe id="ai-preview-frame" sandbox="allow-scripts" title="Code preview"></iframe></div>
    <div class="ai-dialog-foot"><span class="ai-fine" id="ai-preview-note"></span><span class="ai-spacer"></span><button type="button" class="ai-btn" data-close-dialog>Close</button></div>
  </div>
</dialog>

<!-- Image generation -->
<dialog class="ai-dialog" id="ai-image-dlg">
  <form method="dialog" class="ai-dialog-inner">
    <div class="ai-dialog-head"><h2>Generate an image</h2><button class="ai-iconbtn" value="cancel" aria-label="Close">✕</button></div>
    <div class="ai-dialog-body ai-stack">
      <label class="ai-field"><span>Prompt</span><textarea id="ai-image-prompt" rows="3" placeholder="A cinematic mountain lake at sunrise, soft mist, 35mm"></textarea></label>
      <div class="ai-grid-2">
        <label class="ai-field"><span>Size</span>
          <select id="ai-image-size"><option>1024x1024</option><option>1536x1024</option><option>1024x1536</option><option>512x512</option></select>
        </label>
        <label class="ai-field"><span>Count</span><input id="ai-image-count" type="number" min="1" max="4" value="1"></label>
      </div>
      <div class="ai-field"><span>Edit an existing image (optional)</span><input id="ai-image-edit" type="file" accept="image/*"></div>
      <p class="ai-fine" id="ai-image-status"></p>
      <div class="ai-image-results" id="ai-image-results"></div>
    </div>
    <div class="ai-dialog-foot"><span class="ai-spacer"></span><button class="ai-btn" value="cancel">Close</button><button type="button" class="ai-btn ai-btn-primary" id="ai-image-run">Generate</button></div>
  </form>
</dialog>

<!-- Knowledge bases -->
<dialog class="ai-dialog ai-dialog-wide" id="ai-knowledge-dlg">
  <div class="ai-dialog-inner">
    <div class="ai-dialog-head"><h2>Knowledge bases</h2><button type="button" class="ai-iconbtn" data-close-dialog aria-label="Close">✕</button></div>
    <div class="ai-dialog-body ai-split">
      <div class="ai-split-side">
        <div class="ai-inline"><input id="ai-kb-name" placeholder="New knowledge base"><button type="button" class="ai-btn" id="ai-kb-create">Create</button></div>
        <div id="ai-kb-list" class="ai-kb-list"></div>
      </div>
      <div class="ai-split-main">
        <div id="ai-kb-detail" class="ai-kb-detail"><p class="ai-fine">Select a knowledge base to add documents.</p></div>
      </div>
    </div>
    <div class="ai-dialog-foot"><span class="ai-fine">Retrieval runs server-side. Without an embedding provider, a deterministic local lexical embedding is used.</span><span class="ai-spacer"></span><button type="button" class="ai-btn" data-close-dialog>Close</button></div>
  </div>
</dialog>

<!-- Assistants -->
<dialog class="ai-dialog ai-dialog-wide" id="ai-assistant-dlg">
  <div class="ai-dialog-inner">
    <div class="ai-dialog-head"><h2>Assistants</h2><button type="button" class="ai-iconbtn" data-close-dialog aria-label="Close">✕</button></div>
    <div class="ai-dialog-body ai-split">
      <div class="ai-split-side">
        <div class="ai-inline"><input id="ai-assistant-name" placeholder="New assistant"><button type="button" class="ai-btn" id="ai-assistant-create">Create</button></div>
        <div id="ai-assistant-list" class="ai-kb-list"></div>
      </div>
      <div class="ai-split-main">
        <div id="ai-assistant-detail" class="ai-kb-detail"><p class="ai-fine">Select an assistant to edit its instructions.</p></div>
      </div>
    </div>
    <div class="ai-dialog-foot"><span class="ai-spacer"></span><button type="button" class="ai-btn" data-close-dialog>Close</button></div>
  </div>
</dialog>

<!-- Usage -->
<dialog class="ai-dialog" id="ai-usage-dlg">
  <div class="ai-dialog-inner">
    <div class="ai-dialog-head"><h2>Token usage</h2><button type="button" class="ai-iconbtn" data-close-dialog aria-label="Close">✕</button></div>
    <div class="ai-dialog-body ai-stack" id="ai-usage-body"><p class="ai-fine">Loading…</p></div>
  </div>
</dialog>

<!-- Conversation actions -->
<div class="ai-context" id="ai-convo-menu" hidden></div>

<script>
  window.__AI__ = <%- JSON.stringify({ ai, conversations, folders, assistants, knowledge, activeId, dailyTokens, user: { username: user.username, role: user.role } }).replace(/</g, '\\u003c') %>;
</script>
<script src="/public/vendor/ai/marked.umd.js"></script>
<script src="/public/vendor/ai/katex/katex.min.js"></script>
<script src="/public/vendor/ai/highlight/highlight.min.js"></script>
<script type="module" src="/public/ai/ai.js"></script>
<%- include('partials/foot', { appMode: true }) %>
