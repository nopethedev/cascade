<%- include('partials/head', { title: 'Sign in', shellClass: 'auth' }) %>
<section class="auth-aside">
  <div>
    <div class="eyebrow">Workspace access</div>
    <h1 class="auth-statement">Everything you uploaded, <em class="not-italic text-[var(--accent)]">in one place.</em></h1>
    <div class="auth-points">
      <div class="flex items-start gap-3"><i data-lucide="hard-drive" class="mt-0.5 h-4 w-4 flex-none text-[var(--accent)]"></i><span>Files are stored on your own hardware</span></div>
      <div class="flex items-start gap-3"><i data-lucide="zap" class="mt-0.5 h-4 w-4 flex-none text-[var(--accent)]"></i><span>Public links stay fast and cacheable</span></div>
      <div class="flex items-start gap-3"><i data-lucide="users" class="mt-0.5 h-4 w-4 flex-none text-[var(--accent)]"></i><span>Every account has its own quota</span></div>
    </div>
  </div>
  <div class="flex items-center justify-between gap-4 border-t border-white/[0.06] pt-5">
    <span class="foot-mono text-[var(--faint)]"><%= theme.siteName %> · main mode</span>
    <span class="flex items-center gap-1.5 text-[10px] font-medium uppercase tracking-[0.12em] text-[var(--faint)]"><span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>Online</span>
  </div>
</section>

<section class="auth-main">
  <div class="auth-card">
    <div class="mb-7 flex items-center gap-3">
      <span class="brand-mark !h-10 !w-10 !rounded-xl !text-base"><i data-lucide="sparkles" class="!h-[18px] !w-[18px]"></i></span>
      <div>
        <div class="text-[10px] font-semibold uppercase tracking-[0.15em] text-[var(--faint)]">Welcome back</div>
        <h2 class="mt-0.5 text-[22px]">Sign in</h2>
      </div>
    </div>
    <p class="hint mb-6">
      <% if (allowPublicSignup) { %>
        New here? <a href="/register" class="font-medium text-[var(--accent)] hover:underline">Create an account</a>.
      <% } else if (typeof query !== 'undefined' && query.registration === 'disabled') { %>
        Registration is disabled on this server. Ask an administrator for an account.
      <% } else { %>
        Accounts are created by an administrator.
      <% } %>
    </p>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert"><%= error %></div><% } %>
    <form method="post" action="/login" class="grid gap-4">
      <div class="field">
        <label class="label" for="username">Username</label>
        <input id="username" name="username" autocomplete="username" required autofocus />
      </div>
      <div class="field">
        <label class="label" for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <button class="btn btn-block mt-1" type="submit"><i data-lucide="log-in"></i>Sign in</button>
    </form>
    <div class="mt-7 flex items-center justify-between border-t border-white/[0.06] pt-5 text-[11px] text-[var(--faint)]">
      <span>Secure session</span>
      <a href="/docs" class="transition-colors hover:text-[var(--text)]">Read the docs</a>
    </div>
  </div>
</section>
<%- include('partials/foot') %>
