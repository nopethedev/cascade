<%- include('partials/head', { title: 'Sign in', shellClass: 'auth' }) %>
<section class="auth-aside bg-gradient-to-br from-panel via-canvas to-canvas">
  <div class="max-w-[480px]">
    <div class="eyebrow">Sign in</div>
    <h1 class="auth-statement">Everything you uploaded, <em>in one place.</em></h1>
    <div class="auth-points">
      <div>Files are stored on your own hardware</div>
      <div>Public links stay fast and cacheable</div>
      <div>Every account has its own quota</div>
    </div>
  </div>
  <div class="foot-mono faint"><%= theme.siteName %> · main mode</div>
</section>

<section class="auth-main">
  <div class="auth-card rounded-2xl shadow-float">
    <h2 class="text-[22px] tracking-[-0.04em]">Sign in</h2>
    <p class="hint" style="margin:7px 0 22px">
      <% if (allowPublicSignup) { %>
        New here? <a href="/register" style="color:var(--accent)">Create an account</a>.
      <% } else if (typeof query !== 'undefined' && query.registration === 'disabled') { %>
        Registration is disabled on this server. Ask an administrator for an account.
      <% } else { %>
        Accounts are created by an administrator.
      <% } %>
    </p>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert"><%= error %></div><% } %>
    <form method="post" action="/login" class="stack">
      <div class="field">
        <label class="label" for="username">Username</label>
        <input id="username" name="username" autocomplete="username" required autofocus />
      </div>
      <div class="field">
        <label class="label" for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <button class="btn btn-block h-11 rounded-xl" type="submit">Sign in</button>
    </form>
  </div>
</section>
<%- include('partials/foot') %>
