<%- include('partials/head', { title: 'Create account', shellClass: 'auth' }) %>
<section class="auth-aside">
  <div>
    <div class="eyebrow">Create account</div>
    <h1 class="auth-statement">Your own space, <em class="not-italic text-[var(--accent)]">on this server.</em></h1>
    <div class="auth-points">
      <div class="flex items-start gap-3"><i data-lucide="folder-lock" class="mt-0.5 h-4 w-4 flex-none text-[var(--accent)]"></i><span>Files are stored on this server</span></div>
      <div class="flex items-start gap-3"><i data-lucide="gauge" class="mt-0.5 h-4 w-4 flex-none text-[var(--accent)]"></i><span>Every account has its own quota</span></div>
      <div class="flex items-start gap-3"><i data-lucide="layout-grid" class="mt-0.5 h-4 w-4 flex-none text-[var(--accent)]"></i><span>Create documents, games, bots and more</span></div>
    </div>
  </div>
  <div class="flex items-center justify-between gap-4 border-t border-white/[0.06] pt-5">
    <span class="foot-mono text-[var(--faint)]"><%= theme.siteName %> · main mode</span>
    <span class="flex items-center gap-1.5 text-[10px] font-medium uppercase tracking-[0.12em] text-[var(--faint)]"><span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>Open for signup</span>
  </div>
</section>

<section class="auth-main">
  <div class="auth-card">
    <div class="mb-7 flex items-center gap-3">
      <span class="brand-mark !h-10 !w-10 !rounded-xl !text-base"><i data-lucide="user-plus" class="!h-[18px] !w-[18px]"></i></span>
      <div>
        <div class="text-[10px] font-semibold uppercase tracking-[0.15em] text-[var(--faint)]">New account</div>
        <h2 class="mt-0.5 text-[22px]">Create your account</h2>
      </div>
    </div>
    <p class="hint mb-6">Registration is enabled by this server's administrator.</p>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert"><%= error %></div><% } %>
    <form method="post" action="/register" class="grid gap-4">
      <div class="field">
        <label class="label" for="username">Username</label>
        <input id="username" name="username" value="<%= typeof values !== 'undefined' ? values.username : '' %>" autocomplete="username" minlength="3" maxlength="32" required autofocus />
      </div>
      <div class="field">
        <label class="label" for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="6" required />
        <span class="hint">At least 6 characters.</span>
      </div>
      <div class="field">
        <label class="label" for="confirm-password">Confirm password</label>
        <input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" minlength="6" required />
      </div>
      <button class="btn btn-block mt-1" type="submit"><i data-lucide="user-plus"></i>Create account</button>
    </form>
    <p class="hint mt-6 border-t border-white/[0.06] pt-5">Already have an account? <a href="/login" class="font-medium text-[var(--accent)] hover:underline">Sign in</a>.</p>
  </div>
</section>
<%- include('partials/foot') %>
