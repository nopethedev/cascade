<%- include('partials/head', { title: currentFolder ? currentFolder.name : 'Files' }) %>
<%
  const usedPct = quota > 0 ? Math.min(100, Math.round((used / quota) * 100)) : 0;
  const q = (query || '').toLowerCase();
  const fileList = files.filter((f) => !q || f.filename.toLowerCase().includes(q));
  const folderList = (childFolders || []).filter((f) => !q || f.name.toLowerCase().includes(q));
  const extOf = (name) => (name.includes('.') ? name.split('.').pop().slice(0, 4) : 'file');
  const kindOf = (id) => kinds.find((k) => k.id === id) || null;
  const openHref = (f) => (f.kind && f.kind !== 'file' ? '/edit/' + f.id : '/f/' + f.id);
  const totalItems = fileList.length + folderList.length;
%>

<div class="page-head fm-head">
  <div>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Files</a>
      <% for (const crumb of (folderTrail || [])) { %>
        <span>/</span>
        <% if (crumb.id === currentFolder.id) { %><strong><%= crumb.name %></strong><% } else { %><a href="/?folder=<%= crumb.id %>"><%= crumb.name %></a><% } %>
      <% } %>
    </nav>
    <h1 class="page-title"><%= currentFolder ? currentFolder.name : 'Your files' %></h1>
    <p class="lede"><%= totalItems %> item<%= totalItems === 1 ? '' : 's' %><%= q ? ' matching “' + query + '”' : '' %> · <%= prettyBytes(used) %> of <%= prettyBytes(quota) %> used</p>
  </div>
  <div class="actions fm-head-actions">
    <button class="btn btn-ghost" type="button" id="fm-new-folder">New folder</button>
    <label class="btn btn-ghost" for="fm-file-input">Upload</label>
    <a class="btn" href="/create">+ Create</a>
  </div>
</div>

<form id="fm-upload" class="visually-hidden" onsubmit="event.preventDefault();">
  <input id="fm-file-input" type="file" name="files" multiple />
  <input type="hidden" name="folderId" value="<%= folderId %>" />
  <span id="fm-upload-status"></span>
</form>

<section class="fm panel" id="file-manager" data-folder="<%= folderId %>">
  <div class="fm-toolbar">
    <div class="fm-tools-left">
      <label class="fm-check" title="Select all">
        <input type="checkbox" id="fm-select-all" aria-label="Select all items" />
      </label>
      <div class="fm-selection" id="fm-selection" hidden>
        <strong><span id="fm-selected-count">0</span> selected</strong>
        <button class="btn btn-quiet btn-sm" type="button" data-bulk="move">Move</button>
        <button class="btn btn-quiet btn-sm" type="button" data-bulk="copy">Copy</button>
        <button class="btn btn-quiet btn-sm" type="button" data-bulk="delete">Delete</button>
      </div>
      <span class="fm-count" id="fm-count"><%= totalItems %> item<%= totalItems === 1 ? '' : 's' %></span>
    </div>
    <div class="fm-tools-right">
      <span class="fm-storage" title="Storage used">
        <span class="fm-storage-bar"><i style="width:<%= usedPct %>%"></i></span>
        <span><%= prettyBytes(used) %></span>
      </span>
      <form method="get" action="/" class="fm-search" role="search">
        <% if (currentFolder) { %><input type="hidden" name="folder" value="<%= currentFolder.id %>" /><% } %>
        <input type="search" name="q" value="<%= query %>" placeholder="Search this folder…" aria-label="Search files" />
        <% if (query) { %><a class="fm-search-clear" href="/<%= currentFolder ? '?folder=' + currentFolder.id : '' %>" aria-label="Clear search">×</a><% } %>
      </form>
      <details class="fm-menu">
        <summary class="btn btn-quiet btn-sm" aria-label="More actions">•••</summary>
        <div class="fm-menu-list">
          <button type="button" id="fm-folder-menu">New folder</button>
          <button type="button" id="fm-upload-menu">Upload files</button>
          <a href="/create">Create a file</a>
        </div>
      </details>
    </div>
  </div>

  <div class="fm-table-wrap">
    <table class="fm-table" id="fm-table">
      <thead>
        <tr>
          <th class="fm-check-cell"></th>
          <th class="fm-name-col">Name</th>
          <th class="fm-type-col">Type</th>
          <th class="fm-size-col">Size</th>
          <th class="fm-sharing-col">Sharing</th>
          <th class="fm-updated-col">Modified</th>
          <th class="fm-actions-col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody id="fm-body">
        <% if (currentFolder) { %>
          <tr class="fm-row fm-up-row" data-drop-folder="<%= parentFolder ? parentFolder.id : '' %>">
            <td class="fm-check-cell"></td>
            <td colspan="6">
              <a class="fm-up-link" href="<%= parentFolder ? '/?folder=' + parentFolder.id : '/' %>">↑ <%= parentFolder ? parentFolder.name : 'All files' %></a>
            </td>
          </tr>
        <% } %>

        <% for (const f of folderList) { %>
          <tr class="fm-row fm-folder-row" data-folder-id="<%= f.id %>" data-parent-id="<%= f.parentId || '' %>" data-name="<%= f.name.toLowerCase() %>" draggable="false">
            <td class="fm-check-cell">
              <label class="fm-check folder-check" title="Select folder">
                <input type="checkbox" class="fm-select" data-kind="folder" data-id="<%= f.id %>" data-name="<%= f.name %>" aria-label="Select folder <%= f.name %>" />
              </label>
            </td>
            <td>
              <a class="fm-name" href="/?folder=<%= f.id %>">
                <span class="fm-folder-ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h4l2 2h7A2.5 2.5 0 0 1 21 9.5v7A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5v-9Z" fill="currentColor" opacity=".9"/></svg>
                </span>
                <span class="fm-name-text"><strong><%= f.name %></strong><small>Folder</small></span>
              </a>
            </td>
            <td class="fm-muted">Folder</td>
            <td class="fm-muted">—</td>
            <td><span class="badge">Private</span></td>
            <td class="fm-muted fm-date"><%= prettyDate(f.updatedAt) %></td>
            <td class="fm-actions-cell">
              <details class="fm-row-menu">
                <summary aria-label="Actions for <%= f.name %>">•••</summary>
                <div>
                  <a href="/?folder=<%= f.id %>">Open</a>
                  <button type="button" data-folder-action="subfolder" data-id="<%= f.id %>" data-name="<%= f.name %>">New subfolder</button>
                  <button type="button" data-folder-action="move" data-id="<%= f.id %>" data-name="<%= f.name %>">Move to…</button>
                  <button type="button" data-folder-action="rename" data-id="<%= f.id %>" data-name="<%= f.name %>">Rename</button>
                  <button type="button" class="danger" data-folder-action="delete" data-id="<%= f.id %>" data-name="<%= f.name %>">Delete folder</button>
                </div>
              </details>
            </td>
          </tr>
        <% } %>

        <% for (const f of fileList) { const k = kindOf(f.kind); const isDoc = f.kind && f.kind !== 'file'; %>
          <tr class="fm-row fm-file-row" draggable="true" data-file-id="<%= f.id %>" data-name="<%= f.filename.toLowerCase() %>">
            <td class="fm-check-cell">
              <label class="fm-check" title="Select file">
                <input type="checkbox" class="fm-select" data-kind="file" data-id="<%= f.id %>" data-name="<%= f.filename %>" aria-label="Select <%= f.filename %>" />
              </label>
            </td>
            <td>
              <a class="fm-name" href="<%= openHref(f) %>">
                <span class="fm-file-ico fm-ico-<%= f.kind || 'file' %>"><%= k ? k.icon : extOf(f.filename) %></span>
                <span class="fm-name-text">
                  <strong><%= f.filename %></strong>
                  <small><%= k ? k.label : (f.mime || 'File') %></small>
                </span>
              </a>
            </td>
            <td class="fm-muted"><%= k ? k.label : extOf(f.filename).toUpperCase() %></td>
            <td class="fm-muted"><%= prettyBytes(f.size) %></td>
            <td>
              <% if (f.isPublic) { %><span class="badge badge-accent">Public</span><% } else { %><span class="badge">Private</span><% } %>
            </td>
            <td class="fm-muted fm-date"><%= prettyDate(f.updatedAt) %></td>
            <td class="fm-actions-cell">
              <details class="fm-row-menu">
                <summary aria-label="Actions for <%= f.filename %>">•••</summary>
                <div>
                  <a href="<%= openHref(f) %>"><%= isDoc ? 'Edit' : 'Open' %></a>
                  <% if (isDoc) { %><a href="/download/<%= f.id %>">Download</a><% } else { %><a href="/f/<%= f.id %>/raw">Download</a><% } %>
                  <button type="button" data-file-action="move" data-id="<%= f.id %>" data-name="<%= f.filename %>">Move to…</button>
                  <button type="button" data-file-action="copy" data-id="<%= f.id %>" data-name="<%= f.filename %>">Make a copy</button>
                  <button type="button" data-file-action="rename" data-id="<%= f.id %>" data-name="<%= f.filename %>" data-kind="<%= f.kind || 'file' %>">Rename</button>
                  <% if (f.isPublic) { %>
                    <button type="button" data-file-action="unshare" data-id="<%= f.id %>">Make private</button>
                  <% } else { %>
                    <button type="button" data-file-action="share" data-id="<%= f.id %>">Share publicly</button>
                  <% } %>
                  <button type="button" class="danger" data-file-action="delete" data-id="<%= f.id %>" data-name="<%= f.filename %>" data-kind="<%= f.kind || 'file' %>">Delete</button>
                </div>
              </details>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <% if (!totalItems) { %>
      <div class="fm-empty">
        <div class="fm-empty-icon" aria-hidden="true">⌁</div>
        <strong><%= q ? 'No matching items' : 'This folder is empty' %></strong>
        <span><%= q ? 'Try a different search term.' : 'Create something, upload files, or drag files here from your computer.' %></span>
        <% if (!q) { %><div class="fm-empty-actions"><a class="btn" href="/create">+ Create</a><button class="btn btn-ghost" type="button" id="fm-empty-folder">New folder</button></div><% } %>
      </div>
    <% } %>
  </div>
  <div class="fm-drop-hint" id="fm-drop-hint" hidden>Drop into this folder</div>
</section>

<dialog class="dlg" id="fm-folder-dialog">
  <form method="dialog" class="dlg-in" id="fm-folder-form">
    <div>
      <h3 class="dlg-title" id="fm-folder-title">New folder</h3>
      <p class="dlg-msg" id="fm-folder-msg">Folders keep related files together. Files stay exactly where they are when you rename a folder.</p>
    </div>
    <div class="field">
      <label class="label" for="fm-folder-name">Folder name</label>
      <input id="fm-folder-name" maxlength="80" required autocomplete="off" placeholder="e.g. Client work" />
    </div>
    <div class="dlg-actions">
      <button class="btn btn-quiet" value="cancel" type="button" data-close>Cancel</button>
      <button class="btn" type="submit" id="fm-folder-save">Create folder</button>
    </div>
  </form>
</dialog>

<dialog class="dlg" id="fm-place-dialog">
  <form method="dialog" class="dlg-in" id="fm-place-form">
    <div>
      <h3 class="dlg-title" id="fm-place-title">Move items</h3>
      <p class="dlg-msg" id="fm-place-msg">Choose a destination. You can also drag files onto a folder in the list.</p>
    </div>
    <div class="field">
      <label class="label" for="fm-destination">Destination</label>
      <select id="fm-destination">
        <option value="">All files (root)</option>
        <% for (const f of folders) { %><option value="<%= f.id %>" data-parent="<%= f.parentId || '' %>"><%= f.path || f.name %></option><% } %>
      </select>
      <p class="hint" id="fm-place-path">Expand folders in the file list to see their full path here.</p>
    </div>
    <label class="check" id="fm-copy-inline" hidden>
      <input type="checkbox" id="fm-copy-keep" />
      <span>Keep the original in its current folder</span>
    </label>
    <div class="dlg-actions">
      <button class="btn btn-quiet" value="cancel" type="button" data-close>Cancel</button>
      <button class="btn" type="submit" id="fm-place-save">Move</button>
    </div>
  </form>
</dialog>

<script src="/public/file-manager.js"></script>
<%- include('partials/foot') %>
