<%- include('partials/head', { title: 'Files' }) %>
<%
  const usedPct = quota > 0 ? Math.min(100, Math.round((used / quota) * 100)) : 0;
  const q = (query || '').toLowerCase();
  const list = files.filter((f) => !q || f.filename.toLowerCase().includes(q));
  const extOf = (name) => (name.includes('.') ? name.split('.').pop().slice(0, 4) : 'file');
%>

<div class="page-head">
  <div>
    <div class="eyebrow">Workspace</div>
    <h1 class="page-title">Your files</h1>
    <p class="lede"><%= files.length %> file<%= files.length === 1 ? '' : 's' %> · <%= prettyBytes(used) %> of <%= (quota / 1073741824).toFixed(1) %> GB used</p>
  </div>
  <div class="actions">
    <% if (user.role === 'admin') { %><a class="btn btn-ghost" href="/admin">Server overview</a><% } %>
  </div>
</div>

<div class="split">
  <section class="panel">
    <div class="panel-head">
      <div>
        <div class="panel-title">Upload</div>
        <div class="panel-sub">Files are written to the nodes your replication mode selects.</div>
      </div>
    </div>
    <div class="panel-body">
      <form onsubmit="event.preventDefault(); cascadeUpload(this, document.getElementById('up-status'))">
        <label class="drop" data-drop>
          <input type="file" name="files" multiple />
          <div class="drop-title">Drop files here</div>
          <div class="drop-sub">or click to browse · up to 20 files at once</div>
        </label>
        <div class="row-between" style="margin-top:14px">
          <div id="up-status" class="hint"></div>
          <button class="btn" type="submit">Upload</button>
        </div>
      </form>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head"><div class="panel-title">Quota</div></div>
    <div class="panel-body stack">
      <div>
        <div class="meter-row">
          <span><b><%= usedPct %>%</b> used</span>
          <span><%= prettyBytes(used) %> / <%= (quota / 1073741824).toFixed(0) %> GB</span>
        </div>
        <div class="meter"><div class="meter-fill" style="width:<%= usedPct %>%"></div></div>
      </div>
      <dl class="kv">
        <dt>Account</dt><dd><%= user.username %></dd>
        <dt>Role</dt><dd><%= user.role %></dd>
        <dt>Files</dt><dd><%= files.length %></dd>
      </dl>
      <% if (user.role === 'admin') { %><div><a class="btn btn-ghost btn-sm" href="/admin/users">Manage quotas</a></div><% } %>
    </div>
  </section>
</div>

<section class="panel has-table" style="margin-top:16px">
  <div class="panel-head">
    <div>
      <div class="panel-title">Files</div>
      <div class="panel-sub"><%= list.length %> shown<%= q ? ' for “' + query + '”' : '' %></div>
    </div>
    <form method="get" action="/" class="row" style="gap:8px">
      <input type="search" name="q" value="<%= query %>" placeholder="Search files…" style="width:220px;height:34px" aria-label="Search files" />
      <button class="btn btn-ghost btn-sm" type="submit">Search</button>
    </form>
  </div>

  <% if (!list.length) { %>
    <div class="panel-body">
      <div class="empty">
        <div class="empty-ico">∅</div>
        <strong><%= q ? 'No matching files' : 'No files yet' %></strong>
        <span><%= q ? 'Try a different search term.' : 'Upload something and it will show up here.' %></span>
      </div>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>File</th><th>Size</th><th>Copies</th><th>Visibility</th><th class="right">Actions</th></tr>
        </thead>
        <tbody>
          <% for (const f of list) { %>
            <tr>
              <td>
                <a class="file" href="/f/<%= f.id %>">
                  <span class="file-ico"><%= extOf(f.filename) %></span>
                  <span style="min-width:0">
                    <span class="file-name"><%= f.filename %></span>
                    <span class="file-meta"><%= f.mime %></span>
                  </span>
                </a>
              </td>
              <td class="muted nowrap"><%= prettyBytes(f.size) %></td>
              <td><span class="badge"><%= (f.replicas || []).length %>×</span></td>
              <td><% if (f.isPublic) { %><span class="badge badge-accent">public</span><% } else { %><span class="badge">private</span><% } %></td>
              <td>
                <div class="row" style="justify-content:flex-end;gap:4px">
                  <a class="btn btn-quiet btn-sm" href="/f/<%= f.id %>">Open</a>
                  <button class="btn btn-quiet btn-sm" type="button" onclick="cascadeDelete('<%= f.id %>','<%= f.filename.replace(/'/g, '') %>')">Delete</button>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('partials/foot') %>
