</main>
<% if (!(typeof appMode !== 'undefined' && appMode)) { %>
<footer class="foot">
  <div class="foot-in">
    <span class="flex items-center gap-2"><span class="brand-mark !h-5 !w-5 !rounded-md !text-[9px] !shadow-none">C</span> <%= theme.siteName %> <span class="text-[var(--faint)]">— self-hosted files</span></span>
    <span class="foot-mono flex items-center gap-2 text-[var(--faint)]">
      <a class="transition-colors hover:text-[var(--text)]" href="/docs">Docs &amp; API</a>
      <span class="text-[var(--faint)]">/</span>
      <%= typeof mode !== 'undefined' ? mode : 'main' %> mode
      <span class="text-[var(--faint)]">/</span>
      Cascade
    </span>
  </div>
</footer>
<% } %>
<script src="/public/app.js"></script>
</body>
</html>
