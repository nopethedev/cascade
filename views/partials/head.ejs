<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>try { if (localStorage.getItem('cascade-theme') === 'light') document.documentElement.dataset.theme = 'light'; } catch (e) {}</script>
  <title><%= (typeof title !== 'undefined' && title ? title + ' · ' : '') + theme.siteName %></title>
  <link rel="icon" href="/public/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/public/theme.css" />
  <link rel="stylesheet" href="/public/tailwind.css" />
  <script src="/public/vendor/ai/lucide.min.js" defer></script>
  <style>
    :root {
      --accent: <%= theme.accent %>;
      --bg: <%= theme.bg %>;
      --surface: <%= theme.surface %>;
      --text: <%= theme.text %>;
    }
  </style>
</head>
<% const appChrome = (typeof appMode !== 'undefined') && appMode; const appId = (typeof app !== 'undefined') && app ? app : ''; %>
<body<% if (appChrome) { %> class="app-body" data-app="<%= appId %>"<% } %>>
<% if (!appChrome) { %>
<header class="topbar">
  <div class="topbar-in">
    <a class="brand group" href="/" aria-label="<%= theme.siteName %> home">
      <span class="brand-mark" aria-hidden="true"><i data-lucide="sparkles" class="h-[15px] w-[15px]"></i></span>
      <span class="brand-name transition-colors group-hover:text-[var(--text)]"><%= theme.siteName %></span>
    </a>
    <% const currentPath = typeof path !== 'undefined' ? path : ''; %>
    <nav class="nav" aria-label="Primary navigation">
      <% if (user) { %>
        <a href="/" title="Files" aria-label="Files" class="<%= currentPath === '/' ? 'is-active' : '' %>"><i data-lucide="folder"></i><span>Files</span></a>
        <a href="/create" title="Create" aria-label="Create" class="<%= currentPath.startsWith('/create') ? 'is-active' : '' %>"><i data-lucide="plus"></i><span>Create</span></a>
        <a href="/search" title="Search" aria-label="Search" class="<%= currentPath === '/search' ? 'is-active' : '' %>"><i data-lucide="search"></i><span>Search</span></a>
        <a href="/ai" title="Cascade AI" aria-label="Cascade AI" class="<%= currentPath.startsWith('/ai') ? 'is-active' : '' %>"><i data-lucide="sparkles"></i><span>AI</span></a>
        <% if (user.role === 'admin') { %>
          <a href="/admin" title="Admin" aria-label="Admin" class="<%= currentPath.startsWith('/admin') ? 'is-active' : '' %>"><i data-lucide="shield"></i><span>Admin</span></a>
        <% } %>
      <% } else { %>
        <a href="/login" title="Sign in" aria-label="Sign in" class="<%= currentPath === '/login' ? 'is-active' : '' %>"><i data-lucide="log-in"></i><span>Sign in</span></a>
      <% } %>
      <a href="/docs" title="Documentation" aria-label="Documentation" class="<%= currentPath === '/docs' ? 'is-active' : '' %>"><i data-lucide="book-open"></i><span>Docs</span></a>
    </nav>
    <div class="topbar-right">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle light theme" title="Toggle light or dark theme" aria-pressed="false">
        <svg class="theme-ico theme-ico-sun h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg class="theme-ico theme-ico-moon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <% if (user) { %>
        <a class="theme-toggle" href="/settings" aria-label="Account settings" title="Account settings">
          <i data-lucide="user-round" class="h-4 w-4"></i>
        </a>
        <a class="user-chip" href="/settings" title="<%= user.username %> · <%= user.role %>">
          <span class="grid h-5 w-5 place-items-center rounded-full bg-[var(--accent-soft)] text-[8px] font-bold text-[var(--accent)]"><%= user.username.slice(0, 2).toUpperCase() %></span>
          <span class="max-w-[110px] truncate"><%= user.username %></span>
        </a>
        <form method="post" action="/logout"><button class="theme-toggle" type="submit" aria-label="Sign out" title="Sign out"><i data-lucide="log-out" class="h-4 w-4"></i></button></form>
      <% } %>
    </div>
  </div>
</header>
<% } %>
<main class="<%= typeof shellClass !== 'undefined' && shellClass ? shellClass : 'shell' %>">
