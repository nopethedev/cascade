<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= (typeof title !== 'undefined' && title ? title + ' · ' : '') + theme.siteName %></title>
  <link rel="stylesheet" href="/public/theme.css" />
  <style>
    :root {
      --accent: <%= theme.accent %>;
      --bg: <%= theme.bg %>;
      --surface: <%= theme.surface %>;
      --text: <%= theme.text %>;
    }
  </style>
</head>
<body>
<header class="topbar">
  <div class="topbar-in">
    <a class="brand" href="/">
      <span class="brand-mark">C</span>
      <span class="brand-name"><%= theme.siteName %></span>
    </a>
    <% const currentPath = typeof path !== 'undefined' ? path : ''; %>
    <nav class="nav">
      <% if (user) { %>
        <a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Files</a>
        <a href="/create" class="<%= currentPath.startsWith('/create') ? 'is-active' : '' %>">Create</a>
        <a href="/search" class="<%= currentPath === '/search' ? 'is-active' : '' %>">Search</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin" class="<%= currentPath.startsWith('/admin') ? 'is-active' : '' %>">Admin</a>
        <% } %>
      <% } else { %>
        <a href="/login" class="<%= currentPath === '/login' ? 'is-active' : '' %>">Sign in</a>
      <% } %>
      <a href="/docs" class="<%= currentPath === '/docs' ? 'is-active' : '' %>">Docs</a>
    </nav>
    <div class="topbar-right">
      <% if (user) { %>
        <span class="user-chip"><%= user.username %><i>/</i><%= user.role %></span>
        <form method="post" action="/logout"><button class="btn btn-quiet btn-sm" type="submit">Sign out</button></form>
      <% } %>
    </div>
  </div>
</header>
<main class="<%= typeof shellClass !== 'undefined' && shellClass ? shellClass : 'shell' %>">
