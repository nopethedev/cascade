<%
  const adminNav = [
    ['overview', '/admin', 'Overview', 'layout-dashboard'],
    ['analytics', '/admin/analytics', 'Analytics', 'chart-no-axes-column'],
    ['users', '/admin/users', 'Users', 'users'],
    ['files', '/admin/files', 'All files', 'files'],
    ['cleanup', '/admin/cleanup', 'Storage cleanup', 'trash-2'],
    ['nodes', '/admin/nodes', 'Nodes', 'server'],
    ['api-keys', '/admin/api-keys', 'API keys', 'key-round'],
    ['appearance', '/admin/appearance', 'Appearance', 'palette'],
    ['motion', '/admin/motion', 'Motion', 'clapperboard'],
    ['ai', '/admin/ai', 'Cascade AI', 'sparkles'],
  ];
%>
<nav class="tabs" aria-label="Admin sections">
  <% for (const [id, href, label, icon] of adminNav) { %>
    <a href="<%= href %>" class="<%= tab === id ? 'is-active' : '' %>"><i data-lucide="<%= icon %>" class="h-3.5 w-3.5"></i><%= label %></a>
  <% } %>
</nav>
